stash.push = Stash
stash.pop = Pop stash
stash.drop = Drop stash
stash.none = Nothing is stashed in this repository.
# {0} number of stashes
stash.count = {0} stash(es)
stash.pushed = Stashed. Your changes are in the stash.
stash.push.failed = Nothing was stashed. Your working tree is unchanged.
stash.nothing = Nothing to stash. There are no changes to put away, and untracked files count only when they are included.
# {0} stash reference
stash.popped = Popped {0}.
stash.dropped = Dropped {0}.
stash.drop.failed = The stash was not dropped, so it is still in the list.
stash.pop.kept = {0} is still in the list, so nothing is lost. Git's own message is below: it either refused and changed nothing, or applied what it could and left conflicts for you to resolve.
