# {0} how many were opened before the failure reported above this line
edit.partial = {0} files were opened before this one.

# ---- adding a file ----
# The commit window's file list, right-click. Stages the selected rows, which for a file Git has
# never seen is what starts tracking it. No ellipsis and no question: staging discards nothing --
# the working tree is untouched and `git restore --staged` takes it back out.
add.menu = Add file
# {0} how many files the menu item would act on -- the stageable ones only
add.menu.many = Add {0} files
# {0} repository-relative path
add.done = Staged {0}
# {0} how many files were staged
add.done.many = Staged {0} files

# ---- deleting a file ----
# The commit window's file list, Del or right-click. Two halves, and which one runs is decided by
# whether Git has anything for the row rather than by a second menu item.
#
# A row Git tracks -- including a staged addition -- comes out of the index and the file stays
# exactly where it is: the delete.untrack.* spellings below. A row Git has never seen goes to the
# Recycle Bin, because nothing else could bring it back. Neither asks: one destroys nothing, and
# the other is undone from the bin.
delete.menu = Delete file
delete.title = Delete file
# {0} repository-relative path
delete.done = Deleted {0}
delete.missing = {0} is no longer on disk.
# {0} repository-relative path, {1} repository root
delete.outside = {0} is outside {1} and will not be deleted.
delete.reparsepoint = {0} is a symlink or junction. FlickGit will not delete through one.
# {0} repository-relative path, {1} the reason Windows gave
delete.failed = {0} could not be deleted:\n\n{1}
# {0} how many files the menu item would act on
delete.menu.many = Delete {0} files
# {0} how many files were deleted
delete.done.many = Deleted {0} files
# {0} how many files had already gone to the Recycle Bin before the failure reported above this line
delete.partial = {0} of the selected files were already deleted before this one.

# The same item on a row Git has something for: the path comes out of the index, the file stays on
# disk as an untracked file, and the deletion is a change waiting to be committed.
delete.untrack.menu = Remove from Git
# {0} how many files the menu item would act on
delete.untrack.menu.many = Remove {0} files from Git
# {0} repository-relative path
delete.untracked = Removed {0} from Git — the file is still on disk
# {0} how many files were removed from Git
delete.untracked.many = Removed {0} files from Git — the files are still on disk
# A selection holding both kinds. {0} how many went to the Recycle Bin, {1} how many left the index
delete.done.mixed = {0} deleted · {1} removed from Git

# ---- reverting a file ----
# The commit window's file list, right-click. Puts the file back the way HEAD has it, sending
# the copy on disk to the Recycle Bin first -- the same trade delete.* makes, and the reason
# one question is enough for a destructive action.
revert.menu = Revert file…
revert.title = Revert file
# {0} repository-relative path
revert.question = Revert {0}?
revert.body = The version on disk goes to the Recycle Bin, and HEAD's version replaces it — in the working tree and in the index. Nothing is committed and nothing is pushed.
# Used instead of revert.body when every selected row is a staged addition: HEAD has no copy of
# the path, so reverting it means taking it out of the index, and nothing on disk is touched.
revert.body.unstage = HEAD has no copy of this file, so reverting it means taking it back out of the index. The file itself stays exactly where it is, as an untracked file — nothing is deleted and nothing goes to the Recycle Bin.
# Added to revert.body when the selection holds both kinds. {0} how many are staged additions.
revert.unstaged = {0} of them are staged additions HEAD has no copy of: those are taken back out of the index and left on disk as untracked files, untouched.
revert.dirty = Your unsaved edits in the diff pane were never written to disk, so the Recycle Bin will not have them.
revert.yes = Revert
revert.no = Keep
revert.done = Reverted {0}
revert.failed = {0} could not be reverted:
revert.binned = The version that was on disk is in the Recycle Bin.
# {0} how many files the menu item would act on -- the revertable ones only
revert.menu.many = Revert {0} files…
# {0} how many files
revert.question.many = Revert {0} files?
# {0} how many selected rows HEAD does not have, and so will not be touched
revert.skipped = {0} of the selected files are not in HEAD and are not staged additions either — untracked, renamed or conflicted — and are left exactly as they are.
# {0} how many files were reverted
revert.done.many = Reverted {0} files
# {0} how many were reverted before the failure reported above this line
revert.partial = {0} files were reverted before this one.

# ---- the Explorer file menu ----
# Right-click a *file*, beside Blame. `add` stages it, which for a file Git has never seen is what
# starts tracking it; `rm` takes it out of the index and leaves it on disk. Neither asks: neither
# deletes anything.
# {0} repository-relative path
file.added = Staged {0}
file.removed = Removed {0} from Git — the file is still on disk
file.untracked = Git is not tracking {0}, so there is nothing for it to remove.
# {0} the path as it was given, {1} repository root
file.outside = {0} is outside {1} and will not be touched.

# ---- the Explorer folder menu ----
# The same Add and Remove, on a folder the user pointed at. Both act on everything below it, and
# neither asks: `add` stages what is under the folder and `rm` untracks it with `git rm -r --cached`,
# which cannot reach the working tree. The folder itself is never deleted.
# {0} repository-relative path
folder.removed = Removed everything under {0} from Git — the files are still on disk
folder.untracked = Git is not tracking anything under {0}, so there is nothing for it to remove.
# {0} the path as it was given. Reached from a terminal, never from the menu: the entries are not
# drawn on a repository root.
folder.isroot = {0} is the repository root. Commit is what stages a whole repository — Add and Remove act on a folder inside it.

# ---- the Explorer menu on more than one selected item ----
# Add and Remove act on the whole selection, in one Git command each. A selection of one keeps the
# file.* and folder.* wording above: it is the same operation, and "1 items" would be a regression in
# the common case.
# {0} how many items were staged
selection.added = Staged {0} items.
# {0} how many items were removed from the index
selection.removed = Removed {0} items from Git — the files are still on disk
# {0} how many items Git has nothing under
selection.untracked = Git is not tracking any of the {0} selected items, so there is nothing for it to remove.
# Said after a removal that left part of the selection alone, in the same notification rather
# than a second one. Two spellings, because "1 were left alone" is what one string produces in
# the commonest case of all.
# {0} how many were skipped because Git has nothing under them
selection.remove.skipped = {0} more were left alone: Git is not tracking them.
selection.remove.skipped.one = One more was left alone: Git is not tracking it.
# The selection was longer than one command line can carry, so the handler sent the count instead of
# a shortened list -- nothing was staged and nothing was removed. {0} how many were selected
selection.toomany = {0} items are selected — more than one command line can carry. Open the commit window and stage or delete them from the file list.

