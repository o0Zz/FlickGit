stash.confirm.title = Drop this stash?
# {0} stash reference, {1} what the stash was called
stash.confirm.drop = Drop {0} — {1}?\n\nThe changes in it are thrown away without being applied. A stash has no reflog, so FlickGit cannot bring it back.
stash.confirm.yes = Drop
