<views:ReloadableWindow x:Class="FlickGit.App.Views.RepositoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FlickGit.App.Views"
        Title="Repository"
        Width="660" Height="620"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <!-- The repository's own settings, as opposed to FlickGit's: who it commits as, where it pushes,
         and the two preferences FlickGit keeps per repository. All of it is `.git/config`, which is
         why there is one window rather than a tab in the settings window: that one is opened with no
         path and would have needed a repository picker before it could say anything at all. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="RepositoryName" Style="{StaticResource HeaderTitle}" />

                <TextBlock x:Name="RepositoryRoot"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontSize="11"
                           Style="{StaticResource Muted}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,14">
            <StackPanel>

                <!-- ================= Identity ================= -->
                <TextBlock x:Name="IdentitySection" Style="{StaticResource SectionLabel}" />

                <!-- Two radios rather than a checkbox, because the two states are not "on and off":
                     one inherits a value that is shown, the other sets one here. A checkbox would
                     have to be labelled with whichever of those the author found more natural. -->
                <RadioButton x:Name="GlobalIdentityRadio"
                             GroupName="Identity"
                             Margin="0,8,0,0"
                             Checked="OnIdentityScopeChanged" />

                <RadioButton x:Name="RepoIdentityRadio"
                             GroupName="Identity"
                             Margin="0,8,0,0"
                             Checked="OnIdentityScopeChanged" />

                <Grid x:Name="IdentityPanel" Margin="22,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="NameLabel" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" VerticalAlignment="Center" />

                    <TextBlock x:Name="EmailLabel" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,8,0" Style="{StaticResource Muted}" />
                    <TextBox x:Name="EmailBox" Grid.Column="3" VerticalAlignment="Center" />
                </Grid>

                <!-- ================= Remotes ================= -->
                <TextBlock x:Name="RemotesSection" Style="{StaticResource SectionLabel}" Margin="0,24,0,0" />

                <Border Margin="0,8,0,0"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        Background="{StaticResource SurfaceSunken}">
                    <ListBox x:Name="RemoteList"
                             Height="132"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="OnRemoteSelected">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,3" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Url}"
                                               Margin="10,0,0,0"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource Muted}" />

                                    <!-- "tracked", and a differing push url. Both are facts about
                                         the row that the URL alone does not carry. -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Note}"
                                               Margin="10,0,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource Accent}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="RemoteNameLabel" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                    <TextBox x:Name="RemoteNameBox"
                             Grid.Column="1"
                             VerticalAlignment="Center"
                             FontFamily="Cascadia Mono, Consolas, Courier New"
                             TextChanged="OnRemoteFieldChanged" />

                    <TextBlock x:Name="RemoteUrlLabel" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0" Style="{StaticResource Muted}" />
                    <TextBox x:Name="RemoteUrlBox"
                             Grid.Column="3"
                             VerticalAlignment="Center"
                             FontFamily="Cascadia Mono, Consolas, Courier New"
                             TextChanged="OnRemoteFieldChanged" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddRemoteButton" MinWidth="90" IsEnabled="False" Click="OnAddRemote" />
                    <Button x:Name="SaveRemoteButton" Margin="8,0,0,0" MinWidth="110" IsEnabled="False" Click="OnSaveRemote" />

                    <!-- No IsDefault anywhere near this one, and a gap before it. -->
                    <Button x:Name="RemoveRemoteButton" Margin="24,0,0,0" MinWidth="90" IsEnabled="False" Click="OnRemoveRemote" />
                </StackPanel>

                <TextBlock x:Name="RemoteHint"
                           Style="{StaticResource Muted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <!-- ================= FlickGit's own, per repository ================= -->
                <TextBlock x:Name="DefaultsSection" Style="{StaticResource SectionLabel}" Margin="0,24,0,0" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PrimaryBranchLabel" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                    <TextBox x:Name="PrimaryBranchBox"
                             Grid.Column="1"
                             VerticalAlignment="Center"
                             FontFamily="Cascadia Mono, Consolas, Courier New" />

                    <TextBlock x:Name="PrimaryBranchHint"
                               Grid.Column="2"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Style="{StaticResource Muted}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock x:Name="UpstreamAnswerText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="AskAgainButton" Margin="12,0,0,0" Padding="10,4" MinWidth="100" Click="OnAskAgain" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- No IsDefault: Enter in the remote URL box would otherwise save the identity
                         rather than the remote the user was typing. -->
                    <Button x:Name="SaveButton" MinWidth="100" Style="{StaticResource PrimaryButton}" Click="OnSave" />
                    <Button x:Name="CloseButton" Margin="12,0,0,0" MinWidth="80" IsCancel="True" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:ReloadableWindow>
