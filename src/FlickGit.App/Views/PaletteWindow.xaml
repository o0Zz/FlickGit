<Window x:Class="FlickGit.App.Views.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickGit"
        Width="560"
        Height="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Surface}">

    <!-- The repository palette. One text box, one list, one footer.

         A fixed Height rather than SizeToContent: the list length
         changes on every keystroke, and a window that grew and shrank as the user typed would move
         the rows out from under their eyes. A fixed frame with a scrolling list keeps the first row
         in one place, which is where Enter acts.

         Placed by the host near the top of the active screen rather than at the cursor. The palette
         is opened by a hotkey from anywhere, so there is no cursor position that means anything, and
         the same absolute spot every time is what makes it usable without looking. -->

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The query. The prompt is a ">" and, in action mode, the pinned repository's name
                 beside it: the user has to be able to see what the action will be done to. -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&gt;"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontSize="15"
                               FontFamily="Cascadia Mono, Consolas, Courier New"
                               Foreground="{StaticResource Accent}" />

                    <!-- The scope chip. Present only in action mode, and then it is the answer to
                         "which repository is this about". -->
                    <Border Grid.Column="1"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActionMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ScopeText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   FontFamily="Cascadia Mono, Consolas, Courier New" />
                    </Border>

                    <TextBox x:Name="QueryBox"
                             Grid.Column="2"
                             Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             FontFamily="Cascadia Mono, Consolas, Courier New" />
                </Grid>
            </Border>

            <!-- The list. Never focused: the query box keeps the caret and the arrow keys are
                 forwarded, so typing never has to stop to move the selection. -->
            <ListBox Grid.Row="1"
                     x:Name="RowList"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     Focusable="False"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="OnRowActivated">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- The bullet, and the whole of the "something to do" signal. -->
                            <TextBlock Text="●"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{StaticResource Accent}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWork}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Primary}"
                                       FontWeight="SemiBold"
                                       FontFamily="Cascadia Mono, Consolas, Courier New" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Detail}"
                                       Margin="12,0,8,0"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Muted}"
                                       FontSize="11.5" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Trailing}"
                                       FontSize="11.5"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       Foreground="{StaticResource Accent}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Shown in the list's place when there is nothing in it. Always names a next step. -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Hint}"
                       Margin="18"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasHint}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- The exact command Enter would run. CLAUDE.md requires it be visible before Enter,
                 so it is monospaced and trimmed at the end rather than the middle: the verb and the
                 repository matter more than the tail of a long path. -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,0"
                    Padding="14,7">
                <TextBlock Text="{Binding FooterText}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           Style="{StaticResource Muted}" />
            </Border>
        </Grid>
    </Border>
</Window>
