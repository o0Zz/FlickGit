<Window x:Class="FlickGit.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickGit"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface}">

    <!-- A question with two named choices, or three when one of them loses the user's work. Every
         choice is named after what it does rather than "OK" and "Cancel". Every question this window
         asks is a guardrail — create an upstream, pull before pushing, overwrite a file that changed
         on disk — and a user answering "OK" to a question they skim-read is precisely the failure the
         guardrail exists to prevent. -->

    <Border Padding="18,16" MinWidth="360" MaxWidth="560">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource HeaderTitle}" Margin="0,0,0,8" />

            <TextBlock x:Name="QuestionText"
                       TextWrapping="Wrap"
                       MaxWidth="520"
                       LineHeight="18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <!-- Which button is the default is decided per question, in the constructor, and it is
                     the only thing about this dialog that is not fixed.

                     A guardrail's affirmative is not the default. Enter must not commit the user to the
                     consequential half of a question they have not read, and there is no way back from
                     publishing a branch or overwriting a file that changed under the editor.

                     The two that do default to the affirmative — revert and delete, from the commit
                     window's file list — send the copy on disk to the Recycle Bin before anything else
                     happens. That is what earns them one question instead of two, and it is what makes
                     Enter safe here: the answer is undoable by a gesture the user already knows. Both
                     are also performed over a multi-selection, where aiming at a dialog per file is the
                     cost that selection exists to remove.

                     Esc never loses work. In the two-choice form that is IsCancel on NoButton, whose
                     label is a refusal. In the three-choice form both of the first two buttons *do*
                     something irreversible to an edit, so IsCancel moves to CancelButton and the
                     answer Esc gives is "nothing happened" — see ConfirmWindow.AskWithCancel. -->
                <Button x:Name="YesButton" MinWidth="120" Click="OnYes" />
                <Button x:Name="NoButton"
                        MinWidth="100"
                        Margin="8,0,0,0"
                        IsCancel="True"
                        Click="OnNo" />

                <!-- Collapsed for the two-choice form, which is every guardrail consent. Shown only by
                     AskWithCancel, and last because it is the dismissing answer: the same place the
                     Close button sits in every window in the product. -->
                <Button x:Name="CancelButton"
                        MinWidth="100"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
