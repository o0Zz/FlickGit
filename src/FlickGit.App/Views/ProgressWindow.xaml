<Window x:Class="FlickGit.App.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickGit"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <!-- "Show progress in a lightweight dialog, with the submodule update as a distinct
         step." The steps are listed rather than merged into one bar because the submodule
         update hits the network separately and can take noticeably longer than the pull it
         follows — a single bar would look stalled. -->

    <Border Padding="18,16">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource HeaderTitle}" Margin="0,0,0,12" />

            <ItemsControl x:Name="StepList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Glyph}"
                                       FontFamily="Segoe UI Symbol"
                                       Foreground="{Binding GlyphBrush}" />

                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="ResultText"
                       Visibility="Collapsed"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />

            <Border x:Name="DetailBox"
                    Visibility="Collapsed"
                    Margin="0,10,0,0"
                    Padding="10,8"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="DetailText"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas, Courier New"
                             FontSize="11.5" />
                </ScrollViewer>
            </Border>

            <!-- One button, two jobs, exactly as the clone window's does: "Cancel" while the operation
                 runs and "Close" once it has reported. IsCancel is what makes Esc reach it at all —
                 without it this was the one window in the product where the escape key did nothing for
                 its whole life. Enabled from the start for the same reason: a disabled button is a
                 window with no way out of a pull that has stopped answering.

                 No IsDefault here. It is set in code once the operation has reported, because while it
                 is still running this button kills the running rebase — and Enter must never
                 be the key that does that, least of all a keystroke queued before the window painted.
                 Esc asking for it is a deliberate gesture; Enter is habit. -->
            <Button x:Name="CloseButton"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    IsCancel="True"
                    Click="OnClose" />
        </StackPanel>
    </Border>
</Window>
