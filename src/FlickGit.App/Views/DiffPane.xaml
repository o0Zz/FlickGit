<UserControl x:Class="FlickGit.App.Views.DiffPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">

    <Grid Background="{StaticResource SurfaceSunken}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The comparison mode, permanently visible. CLAUDE.md, "The staged-versus-worktree
             trap": this label is the user's only signal about whether an edit in the right pane
             lands in the commit, so it is a header, not a tooltip. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ModeText" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />

                <TextBlock x:Name="NoticeText"
                           Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="10,0"
                           Style="{StaticResource Muted}"
                           FontSize="11" />

                <!-- The editing bar. Hidden entirely when the pane is read-only, so a file that
                     cannot be edited does not offer a Save button that would do nothing. -->
                <StackPanel x:Name="EditingBar"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <TextBlock x:Name="DirtyText"
                               Visibility="Collapsed"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DangerText}" />

                    <TextBlock x:Name="SavedText"
                               Visibility="Collapsed"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontSize="11"
                               Style="{StaticResource Muted}" />

                    <!-- Hunk staging. Beside Save rather than in a context menu because it is
                         the reason the pane exists in the commit window, and because a disabled
                         button with a tooltip explains itself where a missing menu item cannot. -->
                    <Button x:Name="StageHunkButton"
                            MinWidth="86"
                            Padding="8,2"
                            Margin="0,0,6,0"
                            IsEnabled="False"
                            Click="OnStageHunk" />

                    <Button x:Name="UnstageHunkButton"
                            MinWidth="94"
                            Padding="8,2"
                            Margin="0,0,6,0"
                            IsEnabled="False"
                            Click="OnUnstageHunk" />

                    <!-- Revert: take the left side's version of the selected lines. First in the
                         strip because it reads left-to-right the way the panes do, and because it is
                         an edit rather than a Git operation: it belongs beside Save, not beside
                         the staging pair. -->
                    <Button x:Name="RevertHunkButton"
                            MinWidth="94"
                            Padding="8,2"
                            Margin="0,0,6,0"
                            IsEnabled="False"
                            Click="OnRevertHunk" />

                    <Button x:Name="SaveButton"
                            MinWidth="56"
                            Padding="8,2"
                            IsEnabled="False"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ctrl+F. A row in the header stack rather than a panel floating over an editor: the
             Placeholder below spans the whole editor grid and covers anything put in it, and a strip
             under the header is the shape this control already uses for something transient.

             Its buttons set their own MinWidth and Padding for the reason the editing bar's do: the
             application-wide Button style is 88px wide, which is a bar of arrows as long as the
             search box. -->
        <Border x:Name="SearchBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SearchLabel"
                           Style="{StaticResource SectionLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- Chromeless, monospaced, as the three filter boxes elsewhere in the product are:
                     the term being typed is a run of the user's code. -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         FontSize="13"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         VerticalAlignment="Center"
                         TextChanged="OnSearchTextChanged"
                         PreviewKeyDown="OnSearchBoxKeyDown" />

                <!-- Which pane. The two documents are aligned row for row, so without this a match
                     in one pane and the same word in the other are indistinguishable. -->
                <TextBlock x:Name="SearchSideText"
                           Grid.Column="2"
                           Style="{StaticResource Muted}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="10,0,4,0" />

                <Button x:Name="SearchPreviousButton"
                        Grid.Column="3"
                        Content="▲"
                        MinWidth="26"
                        Padding="4,1"
                        Margin="4,0,0,0"
                        Click="OnSearchPrevious" />

                <Button x:Name="SearchNextButton"
                        Grid.Column="4"
                        Content="▼"
                        MinWidth="26"
                        Padding="4,1"
                        Margin="4,0,0,0"
                        Click="OnSearchNext" />

                <!-- MinWidth so that counting up from "1 of 12" to "12 of 12" does not walk the
                     close button sideways under the pointer. -->
                <TextBlock x:Name="SearchCountText"
                           Grid.Column="5"
                           Style="{StaticResource Muted}"
                           FontSize="11"
                           MinWidth="64"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />

                <Button x:Name="SearchCloseButton"
                        Grid.Column="6"
                        Content="✕"
                        MinWidth="26"
                        Padding="4,1"
                        Margin="8,0,0,0"
                        Click="OnSearchClose" />
            </Grid>
        </Border>

        <!-- The staged-file strip, with the one-click restage CLAUDE.md asks for. -->
        <Border x:Name="StagedStrip"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="{StaticResource WarnBackground}"
                BorderBrush="{StaticResource WarnBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <Grid>
                <TextBlock x:Name="StagedStripText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,80,0"
                           FontSize="11.5" />

                <Button x:Name="RestageButton"
                        HorizontalAlignment="Right"
                        MinWidth="70"
                        Padding="8,2"
                        Click="OnRestage" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="11" />
            </Grid.ColumnDefinitions>

            <avalon:TextEditor x:Name="LeftEditor"
                               IsReadOnly="True"
                               ShowLineNumbers="False"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               BorderThickness="0"
                               Background="{StaticResource SurfaceSunken}" />

            <!-- The join, and the whole reason the split is not a fixed 50/50: dragging it gives
                 the right pane room by taking it from the left, which is the only way to see a long
                 line without scrolling. Same control as the three other splitters in the product,
                 and it *is* the rule between the panes - hence no left border on the right editor,
                 which would draw a one-pixel line against a four-pixel bar of the same colour.

                 Not the 14px connector strip that used to sit here, tying each changed block to its
                 counterpart: that read as a colour belonging to one of the editors rather than as a
                 link between them, and the overview strip answers "where are the changes" better
                 than a band that only ever showed the rows already on screen. This is a control the
                 user acts on, not a decoration. -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Editable. IsReadOnly is set in code per file: binary files, oversized
                 files and unresolved conflicts stay read-only. -->
            <avalon:TextEditor x:Name="RightEditor"
                               Grid.Column="2"
                               IsReadOnly="True"
                               ShowLineNumbers="False"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               BorderThickness="0"
                               Background="{StaticResource SurfaceSunken}" />

            <!-- The whole file's changes at a glance, beside the right editor's scrollbar. One
                 strip for both panes: the two documents are aligned row for row, so a second one
                 would be a copy of the first. -->
            <ContentControl x:Name="OverviewHost" Grid.Column="3" />

            <!-- Shown when the file is binary, too large, or nothing is selected. Covers the panes
                 rather than replacing them, so switching files does not rebuild the editors: they
                 are the expensive part of this control. -->
            <Border x:Name="Placeholder"
                    Grid.ColumnSpan="4"
                    Background="{StaticResource SurfaceSunken}">
                <TextBlock x:Name="PlaceholderText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           TextAlignment="Center" />
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid>
                <TextBlock x:Name="LeftLabel" Style="{StaticResource Muted}" FontSize="11" />
                <TextBlock x:Name="RightLabel"
                           HorizontalAlignment="Right"
                           Style="{StaticResource Muted}"
                           FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
