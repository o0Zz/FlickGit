<Window x:Class="FlickGit.App.Views.TagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tags"
        Width="620" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The same filter-first shape as the branch picker: the user works across many tags and
             knows the version they want; typing three characters of it should be enough. -->
        <Border Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&gt;"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           Foreground="{StaticResource Accent}"
                           FontWeight="Bold" />

                <TextBox x:Name="FilterBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         TextChanged="OnFilterChanged"
                         PreviewKeyDown="OnFilterKeyDown" />
            </Grid>
        </Border>

        <!-- Right-click acts on the row under the pointer, exactly as the branch picker does, and
             for the same reason: deleting is the one destructive thing this window can do, and a
             footer button that acts on "whatever is highlighted" is how the wrong tag goes. The menu
             is built in ContextMenuOpening rather than declared here because its one item names the
             remote it would delete from.

             Double-click checks the row out, the way the branch picker's does. It is the invisible
             half of that gesture, which is why the same act is on the menu as well: nobody discovers
             a double-click, and a window whose rows do something has to say so somewhere. -->
        <ListBox x:Name="TagList"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="{StaticResource Surface}"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="OnCheckout"
                 PreviewMouseRightButtonDown="OnRowRightClick"
                 ContextMenuOpening="OnContextMenuOpening">
            <ListBox.ContextMenu>
                <ContextMenu x:Name="RowMenu" />
            </ListBox.ContextMenu>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Target}"
                                   Margin="10,0,0,0"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11"
                                   Style="{StaticResource Muted}" />

                        <!-- The message, for an annotated tag. A lightweight tag has none, which is
                             the only difference between the two that the user can act on. -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Subject}"
                                   Margin="12,0,0,0"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Muted}" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding Date}"
                                   Margin="10,0,0,0"
                                   FontSize="11"
                                   Style="{StaticResource Muted}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Create. Below the list rather than in a dialog of its own, so the tag being typed and
             the tags that already exist are on screen together: "does v1.4.0 exist already" is the
             question every tag creation actually begins with.

             Each box carries its own label above it. Two bare boxes side by side said nothing about
             which was which, and the second one is the part nobody guesses: a tag has a message, and
             whether it has one is the whole difference between an annotated tag and a lightweight
             one. -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NewLabel"
                           Grid.ColumnSpan="3"
                           Margin="0,0,0,8"
                           Style="{StaticResource SectionLabel}" />

                <TextBlock x:Name="NameLabel"
                           Grid.Row="1"
                           Margin="0,0,0,3"
                           FontSize="11"
                           Style="{StaticResource Muted}" />

                <TextBlock x:Name="MessageLabel"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="8,0,0,3"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <!-- Enter creates, and it is handled on these two boxes rather than given to the
                     button as IsDefault — the same choice the stash window makes and for the same
                     reason: IsDefault would fire Create from the filter box and from the list, where
                     the user has just arrowed onto an existing tag and creating a new one is not what
                     they aimed at. -->
                <TextBox x:Name="NameBox"
                         Grid.Row="2"
                         VerticalAlignment="Center"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         PreviewKeyDown="OnNewKeyDown"
                         TextChanged="OnNewNameChanged" />

                <!-- A message here makes the tag annotated, which is why this box also drives the
                     hint below: the kind of tag being created changes as it is typed into. -->
                <TextBox x:Name="NoteBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         PreviewKeyDown="OnNewKeyDown"
                         TextChanged="OnNewNameChanged" />

                <Button x:Name="CreateButton"
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        MinWidth="90"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnCreate" />

                <TextBlock x:Name="NewHint"
                           Grid.Row="3"
                           Grid.ColumnSpan="3"
                           Margin="0,7,0,0"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Style="{StaticResource Muted}" />
            </Grid>
        </Border>

        <!-- Status and Close, and nothing else. Push and the two Delete buttons are gone: creating
             publishes, and deleting is the right-click on the row it acts on. -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        MinWidth="80"
                        IsCancel="True"
                        Click="OnClose" />
            </Grid>
        </Border>
    </Grid>
</Window>
