<Window x:Class="FlickGit.App.Views.TagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tags"
        Width="620" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The same filter-first shape as the branch picker: the user works across many tags and
             knows the version they want; typing three characters of it should be enough. -->
        <Border Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&gt;"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           Foreground="{StaticResource Accent}"
                           FontWeight="Bold" />

                <TextBox x:Name="FilterBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         TextChanged="OnFilterChanged"
                         PreviewKeyDown="OnFilterKeyDown" />
            </Grid>
        </Border>

        <ListBox x:Name="TagList"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="{StaticResource Surface}"
                 HorizontalContentAlignment="Stretch"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Target}"
                                   Margin="10,0,0,0"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11"
                                   Style="{StaticResource Muted}" />

                        <!-- The message, for an annotated tag. A lightweight tag has none, which is
                             the only difference between the two that the user can act on. -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Subject}"
                                   Margin="12,0,0,0"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Muted}" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding Date}"
                                   Margin="10,0,0,0"
                                   FontSize="11"
                                   Style="{StaticResource Muted}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Create. Below the list rather than in a dialog of its own, so the tag being typed and
             the tags that already exist are on screen together: "does v1.4.0 exist already" is the
             question every tag creation actually begins with. -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NewLabel" VerticalAlignment="Center" Margin="0,0,8,0" />

                <TextBox x:Name="NameBox"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         TextChanged="OnNewNameChanged" />

                <!-- A message here makes the tag annotated, which is why this box also drives the
                     hint below: the kind of tag being created changes as it is typed into. -->
                <TextBox x:Name="NoteBox"
                         Grid.Column="2"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         TextChanged="OnNewNameChanged" />

                <Button x:Name="CreateButton"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        MinWidth="90"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnCreate" />

                <TextBlock x:Name="NewHint"
                           Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Margin="0,6,0,0"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Style="{StaticResource Muted}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Publish before delete, and both a deliberate distance from the primary
                         Create button above. Deleting is the destructive one and it is never the
                         default: no IsDefault, so Enter in the filter box cannot reach it. -->
                    <Button x:Name="PushButton" MinWidth="110" IsEnabled="False" Click="OnPush" />
                    <Button x:Name="DeleteButton" Margin="8,0,0,0" MinWidth="110" IsEnabled="False" Click="OnDelete" />
                    <Button x:Name="DeleteRemoteButton" Margin="8,0,0,0" MinWidth="150" IsEnabled="False" Click="OnDeleteEverywhere" />
                    <Button x:Name="CloseButton" Margin="16,0,0,0" MinWidth="80" IsCancel="True" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
