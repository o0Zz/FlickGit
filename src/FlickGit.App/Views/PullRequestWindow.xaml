<Window x:Class="FlickGit.App.Views.PullRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pull request"
        Width="720" Height="620"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <!-- The commit window's shape, deliberately: a header saying what is about to happen, the text
         the user is writing in the middle with the AI filling it in, and one primary button. What is
         missing compared with that window is a file list, and that is the point of the summary line
         instead — a pull request is reviewed on the server, so the question here is "is this the
         right branch going to the right place", not "which of these files".

         Esc closes. Enter in the title creates; the description takes Enter as a newline because it
         is a multi-line box, which is the same rule the commit message box follows. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Where it comes from and where it goes. The target is editable rather than fixed: the
             resolved answer is right nearly always, and when it is not, retyping it here beats
             finding the config key. -->
        <Border Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SourceText"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Text="→"
                           Margin="10,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Accent}"
                           FontWeight="Bold" />

                <ComboBox x:Name="TargetBox"
                          Grid.Column="3"
                          IsEditable="True"
                          VerticalAlignment="Center"
                          FontFamily="Cascadia Mono, Consolas, Courier New" />

                <TextBlock x:Name="ForgeText"
                           Grid.Column="4"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />
            </Grid>
        </Border>

        <!-- What the request would contain. One line, from a local diff, so it costs no round trip
             and is on screen before anything is typed. -->
        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Margin="12,8,12,0"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource Muted}" />

        <!-- One strip, three jobs: a refusal, a warning, and "this is already open". They are
             mutually exclusive by construction — a refusal disables everything below, and an
             existing request replaces Create with Open. -->
        <Border x:Name="NoticeStrip"
                Grid.Row="2"
                Margin="12,10,12,0"
                Padding="10,8"
                Visibility="Collapsed"
                Background="{StaticResource WarnBackground}"
                BorderBrush="{StaticResource WarnBorder}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" />

                <Button x:Name="OpenButton"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        MinWidth="110"
                        Visibility="Collapsed"
                        Click="OnOpenExisting" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="12,12,12,0">
            <TextBlock x:Name="TitleLabel" Style="{StaticResource SectionLabel}" />

            <TextBox x:Name="TitleBox"
                     Margin="0,4,0,0"
                     Padding="6,5"
                     FontSize="13.5"
                     Background="{StaticResource SurfaceSunken}"
                     BorderBrush="{StaticResource Border}"
                     BorderThickness="1"
                     TextChanged="OnTitleChanged" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="12,12,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="DescriptionLabel" Style="{StaticResource SectionLabel}" />

            <TextBox x:Name="DescriptionBox"
                     Grid.Row="1"
                     Margin="0,4,0,0"
                     Padding="6,5"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource SurfaceSunken}"
                     BorderBrush="{StaticResource Border}"
                     BorderThickness="1" />
        </Grid>

        <!-- The two flags, and the button that writes the description. Delete-on-merge hides itself
             on GitHub, where there is no per-request setting for it — a checkbox that silently did
             nothing would be worse than its absence. -->
        <Grid Grid.Row="5" Margin="12,10,12,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="DraftCheck" VerticalAlignment="Center" />
                <CheckBox x:Name="DeleteBranchCheck" Margin="18,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="GenerateButton"
                    HorizontalAlignment="Right"
                    MinWidth="150"
                    Click="OnGenerate" />
        </Grid>

        <Border Grid.Row="6"
                Margin="0,12,0,0"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CreateButton"
                            MinWidth="150"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnCreate" />

                    <Button x:Name="CancelButton"
                            Margin="10,0,0,0"
                            MinWidth="90"
                            IsCancel="True"
                            Click="OnCancel" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
