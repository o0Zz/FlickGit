<views:ReloadableWindow x:Class="FlickGit.App.Views.SwitchBranchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FlickGit.App.Views"
        Title="Switch branch"
        Width="560" Height="480"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- A filter box, not a list to scroll. The user works across many branches and knows the
             name; typing three letters of it should be enough.

             The hint is where a "&gt;" prompt used to be, and it carries the half of this box nobody
             would guess: a name matching nothing is a branch to create. That glyph belongs to the
             palette, where a command grammar is behind it; here there was none for it to promise. -->
        <Border Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <TextBlock x:Name="FilterHint"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           FontSize="14"
                           IsHitTestVisible="False"
                           Style="{StaticResource Muted}" />

                <TextBox x:Name="FilterBox"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         TextChanged="OnFilterChanged"
                         PreviewKeyDown="OnFilterKeyDown" />
            </Grid>
        </Border>

        <!-- Right-click acts on the row under the pointer, which is why the menu is built in
             ContextMenuOpening rather than declared here: what a row offers depends on what it is.
             A remote row cannot be deleted locally, the current branch cannot be deleted at all,
             and the synthetic "create" row is not a branch yet. -->
        <ListBox x:Name="BranchList"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="{StaticResource Surface}"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="OnAccept"
                 PreviewMouseRightButtonDown="OnRowRightClick"
                 ContextMenuOpening="OnContextMenuOpening"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ContextMenu>
                <ContextMenu x:Name="RowMenu" />
            </ListBox.ContextMenu>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- The tooltip is where a worktree's path goes: the Kind column has room for the
                         word and not for a path, and the path is what the user needs before pressing
                         Enter on a row that opens a folder rather than switching. Null on every other
                         row, which leaves the tooltip off rather than showing an empty one. -->
                    <Grid ToolTip="{Binding Hint}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Display}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Brush}" />

                        <!-- Remote-tracking branches are labelled rather than merely sorted below
                             the local ones: switching to one creates a local branch, which is a
                             different action from switching to a branch that exists. -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Kind}"
                                   Margin="10,0,0,0"
                                   FontSize="11"
                                   Style="{StaticResource Muted}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The refusal panel. Hidden until Git refuses, then it shows exactly which files are in
             the way and the three explicit choices from CLAUDE.md, "Switch Branch". -->
        <Border x:Name="BlockedPanel"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="{StaticResource WarnBackground}"
                BorderBrush="{StaticResource WarnBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="BlockedText" TextWrapping="Wrap" FontWeight="SemiBold" />

                <Border Margin="0,8,0,0"
                        Padding="8,6"
                        Background="{StaticResource SurfaceSunken}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="BlockedFiles"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11.5" />
                    </ScrollViewer>
                </Border>

                <TextBlock x:Name="BlockedHint"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           FontSize="11.5"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <!-- Stashing is a choice the user makes here, never something the switch does
                         on their behalf. -->
                    <Button x:Name="StashButton" MinWidth="150" Click="OnStashSwitch" />
                    <Button x:Name="BlockedCloseButton" Margin="8,0,0,0" MinWidth="80" Click="OnClose" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SwitchButton"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            Click="OnAccept" />
                    <Button x:Name="CloseButton" Margin="8,0,0,0" MinWidth="80" IsCancel="True" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:ReloadableWindow>
