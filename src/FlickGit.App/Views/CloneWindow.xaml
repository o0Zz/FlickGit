<Window x:Class="FlickGit.App.Views.CloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone"
        SizeToContent="Height"
        Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <Border Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Style="{StaticResource HeaderTitle}" Margin="0,0,0,14" />

            <!-- URL and target. The URL field is prefilled from the clipboard when what is there
                 looks like a remote — CLAUDE.md calls that "the single biggest time saver here" —
                 and the directory name is derived from it but stays editable. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="URL"
                           VerticalAlignment="Center"
                           Margin="0,0,10,8"
                           Style="{StaticResource SectionLabel}" />

                <TextBox x:Name="UrlBox"
                         Grid.Column="1"
                         Margin="0,0,0,8"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         TextChanged="OnUrlChanged" />

                <TextBlock x:Name="IntoLabel"
                           Grid.Row="1"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Style="{StaticResource SectionLabel}" />

                <TextBox x:Name="DirectoryBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         TextChanged="OnDirectoryChanged" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <!-- Submodules on by default: —recurse-submodules clones them in parallel with the
                     main history, so the default is both the useful one and the fast one. -->
                <CheckBox x:Name="SubmodulesBox" IsChecked="True" />
                <CheckBox x:Name="ShallowBox" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Progress. Determinate, parsed from `clone —progress` on stderr, with the phase
                 named so a long "Resolving deltas" does not look like a hang. -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,16,0,0">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="PhaseText" Style="{StaticResource Muted}" FontSize="11.5" />
                    <TextBlock x:Name="PercentText"
                               HorizontalAlignment="Right"
                               Style="{StaticResource Muted}"
                               FontSize="11.5" />
                </Grid>

                <ProgressBar x:Name="Progress"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Background="{StaticResource SurfaceAlt}"
                             Foreground="{StaticResource Accent}"
                             BorderThickness="0" />

                <Border Margin="0,10,0,0"
                        Padding="8,6"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <ScrollViewer x:Name="LogScroller" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloneButton"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            Click="OnClone" />
                    <Button x:Name="CancelButton"
                            Margin="8,0,0,0"
                            IsCancel="True"
                            Click="OnCancel" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
