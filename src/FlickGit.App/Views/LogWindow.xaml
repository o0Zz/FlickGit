<Window x:Class="FlickGit.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FlickGit.App.Views"
        Title="Log"
        Width="1240" Height="800"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />                <!-- 0 header -->
            <RowDefinition Height="260" MinHeight="120" /> <!-- 1 commits + paging -->
            <RowDefinition Height="4" />                   <!-- 2 splitter -->
            <RowDefinition Height="Auto" />                <!-- 3 range + message -->
            <RowDefinition Height="*" MinHeight="220" />   <!-- 4 files | diff -->
            <RowDefinition Height="Auto" />                <!-- 5 footer -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="RepositoryText" Style="{StaticResource HeaderTitle}" VerticalAlignment="Center" />

                <TextBlock x:Name="BranchText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           Style="{StaticResource Muted}" />

                <TextBlock x:Name="LoadedText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Style="{StaticResource Muted}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Extended, not Multiple: click / Ctrl+click / Shift+click / Shift+arrow, which is
                 the gesture set this feature is copied from. Under Multiple a bare click toggles,
                 and a bare click has to mean "just this one". -->
            <ListBox x:Name="CommitList"
                     SelectionMode="Extended"
                     BorderThickness="0"
                     Background="{StaticResource Surface}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     SelectionChanged="OnCommitSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="34" />
                                <ColumnDefinition Width="Auto" MinWidth="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MinWidth="110" />
                                <ColumnDefinition Width="Auto" MinWidth="120" />
                            </Grid.ColumnDefinitions>

                            <!-- The commit's own number in the branch's history, which is what the
                                 build stamps into its version as the revision. Right-aligned and
                                 muted: it is a gutter, not a field, and it must not compete with
                                 the hash beside it. -->
                            <TextBlock Text="{Binding Revision}"
                                       Margin="0,0,8,0"
                                       TextAlignment="Right"
                                       FontSize="11"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Muted}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ShortSha}"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Subject}"
                                       Margin="10,0"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Refs}"
                                       Margin="0,0,10,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Accent}" />

                            <TextBlock Grid.Column="4"
                                       Text="{Binding Author}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Muted}" />

                            <TextBlock Grid.Column="5"
                                       Text="{Binding Date}"
                                       Margin="10,0,0,0"
                                       FontSize="11"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Muted}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,1"
                    Padding="10,5">
                <Grid>
                    <TextBlock x:Name="PagingText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Style="{StaticResource Muted}" />

                    <Button x:Name="LoadMoreButton"
                            HorizontalAlignment="Right"
                            MinWidth="120"
                            Padding="8,3"
                            Click="OnLoadMore" />
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource Border}"
                      ResizeBehavior="PreviousAndNext" />

        <Border Grid.Row="3"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RangeText" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />

                    <!-- The unselected-commit disclosure. Its own element and its own colour: a
                         combined diff that quietly swept in commits the user did not pick is the
                         one failure this window must not have. -->
                    <TextBlock x:Name="GapText"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" />
                </StackPanel>

                <TextBlock x:Name="SubjectText"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />

                <TextBox x:Name="BodyBox"
                         Margin="0,4,0,0"
                         MaxHeight="110"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Visibility="Collapsed"
                         FontFamily="Cascadia Mono, Consolas, Courier New" />

                <TextBlock x:Name="MetaText"
                           Margin="0,4,0,0"
                           FontSize="11"
                           Style="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,0,1,1"
                        Padding="10,6">
                    <TextBlock x:Name="FilesHeader" Style="{StaticResource SectionLabel}" />
                </Border>

                <ListBox Grid.Row="1"
                         x:Name="FileList"
                         BorderThickness="0,0,1,0"
                         BorderBrush="{StaticResource Border}"
                         Background="{StaticResource Surface}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         PreviewMouseRightButtonDown="OnFileRowRightClick"
                         SelectionChanged="OnFileSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- Declared here rather than built on opening, unlike the pickers': its one item
                         is the same word whatever the row is. The row still has to be selected first,
                         which is what PreviewMouseRightButtonDown above is for — a ListBox does not
                         select on right-click, so without it Blame would open the file that happened
                         to be highlighted rather than the one under the pointer. -->
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="BlameFileItem" Click="OnBlameFile" />
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <!-- The commit window's row template minus the tick box, which is the one
                         column that would be a lie here: nothing in this window is committed. -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding StatusCode}"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Directory, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                                    <Run Text="{Binding FileName, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Added}"
                                           Margin="8,0,4,0"
                                           MinWidth="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="11"
                                           Foreground="#FF1F7A33" />

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Removed}"
                                           MinWidth="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="11"
                                           Foreground="{StaticResource DangerText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}"
                          ResizeBehavior="PreviousAndNext" />

            <views:DiffPane x:Name="Diff" Grid.Column="2" />
        </Grid>

        <Border Grid.Row="5"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ChangelogButton" MinWidth="140" Padding="8,3" IsEnabled="False" Click="OnChangelog" />
                    <Button x:Name="SavePatchButton" Margin="8,0,0,0" MinWidth="130" Padding="8,3" IsEnabled="False" Click="OnSavePatch" />
                    <Button x:Name="CloseButton" Margin="16,0,0,0" MinWidth="80" Padding="8,3" IsCancel="True" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
