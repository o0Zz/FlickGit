<Window x:Class="FlickGit.App.Views.CommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FlickGit.App.Views"
        Title="{Binding Title}"
        Width="1180" Height="720"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />                <!-- 0 header -->
            <RowDefinition Height="Auto" />                <!-- 1 resolution bar -->
            <RowDefinition Height="*" MinHeight="160" />   <!-- 2 files | diff -->
            <RowDefinition Height="4" />                   <!-- 3 splitter -->
            <RowDefinition Height="104" MinHeight="76" />  <!-- 4 commit message -->
            <RowDefinition Height="Auto" />                <!-- 5 footer -->
        </Grid.RowDefinitions>

        <!-- Header: repository, branch, ahead/behind. The repository name is shown even
             though the user chose it, because the same window is opened from the tray, from
             the CLI and (Phase 4) from a popup that resolved the folder on the user's
             behalf. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding RepositoryName}" Style="{StaticResource HeaderTitle}" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>

                <!-- The branch selector. CLAUDE.md, "Branch Selector": there is no separate
                     "commit in new branch" action, because this is it. Free text that is not an
                     existing branch is a new branch name, and the hint beside it says which of the
                     three things Enter will do before the user presses it. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="BranchLabel"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Style="{StaticResource SectionLabel}" />

                    <ComboBox x:Name="BranchBox"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              MinWidth="220"
                              MaxWidth="320"
                              ItemsSource="{Binding Branches}"
                              Text="{Binding BranchInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontFamily="Cascadia Mono, Consolas, Courier New"
                              VerticalContentAlignment="Center" />

                    <TextBlock Text="{Binding BranchHint}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontSize="11"
                               MinWidth="120">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <!-- An invalid ref name is the one hint that has to shout: it
                                         is the only state where Commit is disabled. -->
                                    <DataTrigger Binding="{Binding BranchResolution.Intent}" Value="Invalid">
                                        <Setter Property="Foreground" Value="{StaticResource DangerText}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BranchResolution.Intent}" Value="NewBranch">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding AheadBehindText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Muted}"
                           FontFamily="Cascadia Mono, Consolas, Courier New" />
            </Grid>
        </Border>

        <!-- The resolution bar. Shown only while the repository is part-way through a merge,
             rebase, cherry-pick or revert, which is the one state where the way forward is not
             the Commit button at the bottom of this window.

             Two lines rather than one, and the second is load-bearing: "ours" and "theirs" are
             reversed during a rebase, so the buttons keep Git's words and this says what they
             mean right now. -->
        <Border Grid.Row="1"
                Background="{StaticResource WarnBackground}"
                BorderBrush="{StaticResource WarnBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMergeInProgress}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding MergeHeadline}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MergeSideExplanation}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Style="{StaticResource Muted}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <!-- Not IsDefault: Enter belongs to the message box, and a key that committed
                         in one state and continued a rebase in another is the ambiguity this
                         window cannot afford. -->
                    <Button x:Name="ContinueMergeButton"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ContinueMergeCommand}" />
                    <Button x:Name="AbortMergeButton"
                            Margin="8,0,0,0"
                            Content="{Binding AbortMergeText}"
                            Command="{Binding AbortMergeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="260" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,0,1,1"
                        Padding="10,6">
                    <Grid>
                        <TextBlock x:Name="FilesHeader" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding SelectionText}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource Muted}"
                                   FontSize="11" />
                    </Grid>
                </Border>

                <!-- Extended, not Multiple, and the same choice the log window's list makes: click,
                     Ctrl+click, Shift+click and Shift+arrow. Under Multiple a bare click toggles, and
                     a bare click has to mean "just this one".

                     SelectedItem stays bound because it is the *anchor* row — what the diff pane
                     shows and what a save is about. SelectedItems is not bindable, so the rest of the
                     selection is pushed to the view model from SelectionChanged. -->
                <ListBox Grid.Row="1"
                         x:Name="FileList"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                         SelectionMode="Extended"
                         SelectionChanged="OnFileListSelectionChanged"
                         BorderThickness="0,0,1,0"
                         BorderBrush="{StaticResource Border}"
                         Background="{StaticResource Surface}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ContextMenuOpening="OnFileListContextMenuOpening"
                         KeyDown="OnFileListKeyDown">
                    <!-- On the ListBox rather than on each row, so PlacementTarget is the list and
                         its DataContext is the view model. A menu declared per row would be looking
                         at a FileChangeItem, which owns no commands. The rows it acts on are the
                         selected ones, and ContextMenuOpening is what settles which those are before
                         the menu is drawn — and labels each item with how many it would touch. -->
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <!-- The three conflict items, above everything else because while a
                                 conflict is on screen they are what the window is for. Collapsed
                                 unless the selection holds a conflicted row, so the ordinary menu
                                 is the menu it has always been.

                                 Use ours and Use theirs hide individually as well: a conflict where
                                 one side deleted the path has no version to take on that side, and
                                 Git would answer a button press with "does not have our version". -->
                            <MenuItem x:Name="TakeOursMenuItem"
                                      Command="{Binding PlacementTarget.DataContext.TakeOursCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem x:Name="TakeTheirsMenuItem"
                                      Command="{Binding PlacementTarget.DataContext.TakeTheirsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem x:Name="MarkResolvedMenuItem"
                                      Command="{Binding PlacementTarget.DataContext.MarkResolvedCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator x:Name="ConflictSeparator" />
                            <!-- Edit and Add first, together above the separator, because they are the
                                 two items here that destroy nothing: one hands the file to an editor,
                                 the other stages it — which the working tree never feels and an
                                 unstage takes straight back out. That is also why neither has an
                                 ellipsis: nothing is asked. -->
                            <MenuItem x:Name="EditFileMenuItem"
                                      Command="{Binding PlacementTarget.DataContext.EditFileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem x:Name="AddFileMenuItem"
                                      Command="{Binding PlacementTarget.DataContext.AddFileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <!-- Revert above Delete, and separated from it. They are the two
                                 destructive things this window does and they are not the same
                                 destructive thing: Revert puts a tracked file back the way HEAD has
                                 it, Delete removes the file itself. Both go through the Recycle Bin,
                                 which is what lets either sit behind one question — and what lets
                                 Enter answer it. -->
                            <MenuItem x:Name="RevertFileMenuItem"
                                      Command="{Binding PlacementTarget.DataContext.RevertFileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <!-- The gesture is spelt out here because the key is the list's own
                                 handler rather than a RoutedCommand, so nothing fills this in. It is
                                 also the only place the key is discoverable, and "Del" is the same
                                 word in every language this ships in. -->
                            <MenuItem x:Name="DeleteFileMenuItem"
                                      InputGestureText="Del"
                                      Command="{Binding PlacementTarget.DataContext.DeleteFileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The tick box is the commit's contents. Untracked files
                                     arrive unticked, which CLAUDE.md calls the single most
                                     valuable safety default in the product. -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusCode}"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUntracked}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <!-- Directory muted, file name plain. On a list of forty
                                         paths sharing a prefix, the last segment is the only
                                         part being read. -->
                                    <Run Text="{Binding Directory, Mode=OneWay}"
                                         Foreground="{StaticResource TextMuted}" />
                                    <Run Text="{Binding FileName, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Added}"
                                           Margin="8,0,4,0"
                                           MinWidth="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="11"
                                           Foreground="#FF1F7A33" />

                                <TextBlock Grid.Column="4"
                                           Text="{Binding Removed}"
                                           MinWidth="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="11"
                                           Foreground="{StaticResource DangerText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,1,1,0"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SelectAllButton" MinWidth="46" Padding="8,3" Command="{Binding SelectAllCommand}" />
                        <Button x:Name="SelectNoneButton" MinWidth="52" Padding="8,3" Margin="6,0,0,0" Command="{Binding SelectNoneCommand}" />
                        <Button x:Name="RefreshButton" MinWidth="66" Padding="8,3" Margin="6,0,0,0" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}"
                          ResizeBehavior="PreviousAndNext" />

            <views:DiffPane x:Name="Diff" Grid.Column="2" />
        </Grid>

        <!-- The rule between the diff and the message is draggable, like every other
             division in the window. A long body is read by taking the space from the file
             list and the diff pane, which share the row above. Not persisted and not a
             setting: the resident service keeps one pre-warmed window, so the drag lasts
             the session. -->
        <GridSplitter Grid.Row="3"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource Border}"
                      ResizeBehavior="PreviousAndNext" />

        <!-- Commit message -->
        <Border Grid.Row="4"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The header and the Generate button share a row: CLAUDE.md's mock-up puts the
                     button beside the message rather than in the button strip, where it would read
                     as a third thing that commits. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="MessageHeader"
                               Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,0,5" />

                    <!-- Collapsed rather than disabled when no provider, key or consent is
                         configured: there is nothing the user can do about that from here, and
                         Settings is where it is fixed. -->
                    <Button x:Name="GenerateButton"
                            Grid.Column="1"
                            Margin="8,0,0,5"
                            Padding="8,3"
                            Command="{Binding GenerateCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAiConfigured}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBox Grid.Row="1"
                         x:Name="MessageBox"
                         Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas, Courier New" />
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <!-- The outcome when there is one, the keyboard map until then. Enter committing
                     rather than inserting a newline is the one thing about this window nobody can
                     guess, so it says so where there is otherwise nothing to read. -->
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <TextBlock x:Name="HintText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasStatusText}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CommitPushButton"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CommitAndPushCommand}"
                            Content="{Binding CommitAndPushText}"
                            IsDefault="True" />
                    <Button x:Name="CommitButton"
                            Margin="8,0,0,0"
                            Command="{Binding CommitCommand}" />
                    <Button x:Name="CloseButton"
                            Margin="8,0,0,0"
                            IsCancel="True"
                            Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
