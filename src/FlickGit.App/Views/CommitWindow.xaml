<Window x:Class="FlickGit.App.Views.CommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FlickGit.App.Views"
        Title="{Binding Title}"
        Width="1180" Height="720"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: repository, branch, ahead/behind. The repository name is shown even
             though the user chose it, because the same window is opened from the tray, from
             the CLI and (Phase 4) from a popup that resolved the folder on the user's
             behalf. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding RepositoryName}" Style="{StaticResource HeaderTitle}" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>

                <!-- The branch selector. CLAUDE.md, "Branch Selector": there is no separate
                     "commit in new branch" action, because this is it. Free text that is not an
                     existing branch is a new branch name, and the hint beside it says which of the
                     three things Enter will do before the user presses it. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="BranchLabel"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Style="{StaticResource SectionLabel}" />

                    <ComboBox x:Name="BranchBox"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              MinWidth="220"
                              MaxWidth="320"
                              ItemsSource="{Binding Branches}"
                              Text="{Binding BranchInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontFamily="Cascadia Mono, Consolas, Courier New"
                              VerticalContentAlignment="Center" />

                    <TextBlock Text="{Binding BranchHint}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontSize="11"
                               MinWidth="120">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <!-- An invalid ref name is the one hint that has to shout: it
                                         is the only state where Commit is disabled. -->
                                    <DataTrigger Binding="{Binding BranchResolution.Intent}" Value="Invalid">
                                        <Setter Property="Foreground" Value="{StaticResource DangerText}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BranchResolution.Intent}" Value="NewBranch">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding AheadBehindText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Muted}"
                           FontFamily="Cascadia Mono, Consolas, Courier New" />
            </Grid>
        </Border>

        <!-- The warning strip: committing to the primary branch, or unresolved conflicts.
             Its own row rather than an overlay, so it pushes the layout down and cannot be
             missed. -->
        <Border Grid.Row="1"
                Background="{StaticResource WarnBackground}"
                BorderBrush="{StaticResource WarnBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNotice}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="260" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,0,1,1"
                        Padding="10,6">
                    <Grid>
                        <TextBlock x:Name="FilesHeader" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding SelectionText}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource Muted}"
                                   FontSize="11" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         x:Name="FileList"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                         BorderThickness="0,0,1,0"
                         BorderBrush="{StaticResource Border}"
                         Background="{StaticResource Surface}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The tick box is the commit's contents. Untracked files
                                     arrive unticked, which CLAUDE.md calls the single most
                                     valuable safety default in the product. -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusCode}"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUntracked}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <!-- Directory muted, file name plain. On a list of forty
                                         paths sharing a prefix, the last segment is the only
                                         part being read. -->
                                    <Run Text="{Binding Directory, Mode=OneWay}"
                                         Foreground="{StaticResource TextMuted}" />
                                    <Run Text="{Binding FileName, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Added}"
                                           Margin="8,0,4,0"
                                           MinWidth="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="11"
                                           Foreground="#FF1F7A33" />

                                <TextBlock Grid.Column="4"
                                           Text="{Binding Removed}"
                                           MinWidth="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="11"
                                           Foreground="{StaticResource DangerText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,1,1,0"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SelectAllButton" MinWidth="46" Padding="8,3" Command="{Binding SelectAllCommand}" />
                        <Button x:Name="SelectNoneButton" MinWidth="52" Padding="8,3" Margin="6,0,0,0" Command="{Binding SelectNoneCommand}" />
                        <Button x:Name="RefreshButton" MinWidth="66" Padding="8,3" Margin="6,0,0,0" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}"
                          ResizeBehavior="PreviousAndNext" />

            <views:DiffPane x:Name="Diff" Grid.Column="2" />
        </Grid>

        <!-- Commit message -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="MessageHeader" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />

                <TextBox Grid.Row="1"
                         x:Name="MessageBox"
                         Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="58"
                         MaxHeight="140"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas, Courier New" />
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CommitPushButton"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CommitAndPushCommand}"
                            IsDefault="True" />
                    <Button x:Name="CommitButton"
                            Margin="8,0,0,0"
                            Command="{Binding CommitCommand}" />
                    <Button x:Name="CancelButton"
                            Margin="8,0,0,0"
                            IsCancel="True"
                            Click="OnCancel" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
