<Window x:Class="FlickGit.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickGit"
        Width="600"
        Height="620"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource Surface}">

    <!-- The settings the user actually changes, and nothing else. CLAUDE.md, Phase 5 dropped the
         full settings window on purpose: its largest section was a drag-and-drop action editor,
         more UI than Phases 1 to 4 together, for a file that is documented and hand-editable.

         That argument holds for the action list. It does not hold for "is the context menu on"
         and "which language is this", which are the two things a new user looks for first and
         neither of which is guessable from a JSON key name. So: three tabs, the common switches,
         and a line pointing at the two files for everything else. -->

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs"
                    Background="Transparent"
                    BorderBrush="{StaticResource Border}">

            <!-- ================= Settings ================= -->
            <TabItem x:Name="GeneralTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,14">
                    <StackPanel>

                        <TextBlock x:Name="ExplorerSection" Style="{StaticResource SectionLabel}" />

                        <CheckBox x:Name="ContextMenuBox" Margin="0,8,0,0" />
                        <TextBlock x:Name="ContextMenuHint"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="22,3,0,0" />

                        <CheckBox x:Name="AutostartBox" Margin="0,12,0,0" />
                        <TextBlock x:Name="AutostartHint"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="22,3,0,0" />

                        <TextBlock x:Name="CommitSection"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,22,0,0" />

                        <CheckBox x:Name="WarnPrimaryBox" Margin="0,8,0,0" />
                        <CheckBox x:Name="CloseAfterBox" Margin="0,10,0,0" />
                        <CheckBox x:Name="NotifyBox" Margin="0,10,0,0" />

                        <!-- The AI section exists because the key had nowhere to go. It was
                             `flick ai key set` and nothing else, which is a fine way to store a
                             secret and a hopeless way to discover that you can. Same argument as
                             the context-menu checkbox: not guessable from a JSON key name, and in
                             this case not in the JSON file at all. -->
                        <TextBlock x:Name="AiSection"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,22,0,0" />

                        <TextBlock x:Name="AiProviderLabel"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"
                                   Margin="0,8,0,0" />

                        <ComboBox x:Name="AiProviderBox"
                                  Margin="0,4,0,0"
                                  HorizontalAlignment="Left"
                                  MinWidth="240"
                                  Padding="6,4"
                                  SelectionChanged="OnAiProviderChanged" />

                        <!-- The key is never shown, only reported as present or absent: it is in
                             Credential Manager and this window has no business reading it back. -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="AiKeyButton" Padding="10,4" Click="OnSetApiKey" />
                            <Button x:Name="AiKeyClearButton"
                                    Margin="8,0,0,0"
                                    Padding="10,4"
                                    Click="OnClearApiKey" />
                        </StackPanel>

                        <TextBlock x:Name="AiKeyStatus"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <CheckBox x:Name="AiAllowBox" Margin="0,12,0,0" />
                        <TextBlock x:Name="AiAllowHint"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="22,3,0,0" />

                        <TextBlock x:Name="LanguageSection"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,22,0,0" />

                        <ComboBox x:Name="LanguageBox"
                                  Margin="0,8,0,0"
                                  HorizontalAlignment="Left"
                                  MinWidth="240"
                                  Padding="6,4" />

                        <TextBlock x:Name="LanguageHint"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <!-- The escape hatch, and the honest one: this window is a shortcut to the
                             common switches, not a replacement for the files. -->
                        <Border Margin="0,24,0,0"
                                Padding="12,10"
                                Background="{StaticResource SurfaceAlt}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock x:Name="AdvancedText" TextWrapping="Wrap" />

                                <TextBlock x:Name="AdvancedPaths"
                                           Style="{StaticResource Muted}"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />

                                <Button x:Name="OpenFolderButton"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Click="OnOpenFolder" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Help ================= -->
            <TabItem x:Name="HelpTab">
                <Grid Margin="16,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- A FlowDocument rather than a TextBox: the file is Markdown, and the point of
                         shipping it as a file is that it can be rewritten without a build. -->
                    <FlowDocumentScrollViewer x:Name="HelpView"
                                              Background="Transparent"
                                              Padding="0"
                                              VerticalScrollBarVisibility="Auto"
                                              IsToolBarVisible="False" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,6,0">
                        <TextBlock x:Name="HelpPathText"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="300" />

                        <Button x:Name="EditHelpButton"
                                Margin="12,0,0,0"
                                Padding="10,4"
                                MinWidth="0"
                                Click="OnEditHelp" />

                        <Button x:Name="ReloadHelpButton"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                MinWidth="0"
                                Click="OnReloadHelp" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= About ================= -->
            <TabItem x:Name="AboutTab">
                <StackPanel Margin="24,28,24,20" HorizontalAlignment="Center">

                    <Image x:Name="AppIcon"
                           Width="56"
                           Height="56"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock x:Name="AboutName"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,14,0,0"
                               Text="FlickGit" />

                    <TextBlock x:Name="AboutVersion"
                               Style="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />

                    <TextBlock x:Name="AboutTagline"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               LineHeight="19"
                               Margin="0,18,0,0" />

                    <TextBlock x:Name="AboutAuthor"
                               Style="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0" />

                    <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Hyperlink x:Name="RepositoryLink"
                                   Foreground="{StaticResource Accent}"
                                   RequestNavigate="OnNavigate"
                                   NavigateUri="https://github.com/o0Zz/FlickGit/">
                            <Run Text="https://github.com/o0Zz/FlickGit/" />
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>
            </TabItem>

        </TabControl>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource Muted}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="2,0,12,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="100"
                        IsDefault="True"
                        Click="OnSave" />

                <Button x:Name="CloseButton"
                        MinWidth="90"
                        Margin="8,0,0,0"
                        IsCancel="True"
                        Click="OnClose" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
