<Window x:Class="FlickGit.App.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changelog"
        Width="820" Height="680"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0 what it covers -->
            <RowDefinition Height="Auto" />  <!-- 1 style + write again -->
            <RowDefinition Height="*" />     <!-- 2 the changelog itself -->
            <RowDefinition Height="Auto" />  <!-- 3 footer -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="RepositoryText" Style="{StaticResource HeaderTitle}" />

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="RangeText" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />

                    <!-- The log window's gap disclosure, repeated here for the log window's reason: a
                         changelog is written over the whole range, so it describes commits a gapped
                         selection passed over, and this is the only place that says so. -->
                    <TextBlock x:Name="GapText"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StyleLabel" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />

                    <ComboBox x:Name="StyleBox"
                              Margin="10,0,0,0"
                              MinWidth="150"
                              VerticalAlignment="Center"
                              SelectionChanged="OnStyleChanged" />
                </StackPanel>

                <Button x:Name="WriteButton"
                        HorizontalAlignment="Right"
                        MinWidth="120"
                        Padding="8,3"
                        Click="OnWrite" />
            </Grid>
        </Border>

        <!-- Editable, and that is the point: a changelog is a draft. Nothing here writes to the
             repository, so an edit costs a keystroke and risks nothing. There is no working tree on
             the other side of this box. -->
        <TextBox Grid.Row="2"
                 x:Name="ChangelogBox"
                 Margin="14,10"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 FontFamily="Cascadia Mono, Consolas, Courier New"
                 TextChanged="OnTextChanged" />

        <Border Grid.Row="3"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyButton" MinWidth="90" Padding="8,3" Click="OnCopy" />
                    <Button x:Name="SaveButton" Margin="8,0,0,0" MinWidth="110" Padding="8,3" Click="OnSave" />
                    <Button x:Name="CloseButton" Margin="16,0,0,0" MinWidth="80" Padding="8,3" IsCancel="True" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
