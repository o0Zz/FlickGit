<Window x:Class="FlickGit.App.Views.SubmodulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Submodules"
        Width="680" Height="520"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The same filter-first shape as the branch and tag pickers. A repository with twenty
             submodules is exactly the one where finding the row matters. -->
        <Border Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&gt;"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           Foreground="{StaticResource Accent}"
                           FontWeight="Bold" />

                <TextBox x:Name="FilterBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         TextChanged="OnFilterChanged"
                         PreviewKeyDown="OnFilterKeyDown" />
            </Grid>
        </Border>

        <!-- Right-click acts on the row under the pointer, as in the two windows either side of
             this one, and the menu is built in ContextMenuOpening because what a row offers is what
             the row *is*: an uninitialised submodule can only be initialised, and one that is not
             there yet cannot be opened in Explorer.

             Double-click opens the folder rather than doing anything to the repository. Every other
             gesture here writes something, so the invisible one is the one that cannot. -->
        <ListBox x:Name="ModuleList"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="{StaticResource Surface}"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="OnOpenFolder"
                 PreviewMouseRightButtonDown="OnRowRightClick"
                 ContextMenuOpening="OnContextMenuOpening">
            <ListBox.ContextMenu>
                <ContextMenu x:Name="RowMenu" />
            </ListBox.ContextMenu>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ToolTip="{Binding Url}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Path}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Url}"
                                   Margin="12,0,0,0"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource Muted}" />

                        <!-- The one column with something to do in it, so it is the one that is not
                             muted: "changed" means commit it, "not initialised" means fetch it. -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding State}"
                                   Margin="12,0,0,0"
                                   FontSize="11"
                                   Foreground="{Binding StateBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Add. Below the list for the reason the tag window's create panel is: "is this already
             here" is the question adding a submodule begins with, and the answer is the rows above.

             Two boxes rather than one, because a submodule is a URL *and* a place to put it — which
             is also why this is the one thing in the product that cannot be a filter-box gesture. -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="AddLabel"
                           Grid.ColumnSpan="3"
                           Margin="0,0,0,8"
                           Style="{StaticResource SectionLabel}" />

                <TextBlock x:Name="UrlLabel"
                           Grid.Row="1"
                           Margin="0,0,0,3"
                           FontSize="11"
                           Style="{StaticResource Muted}" />

                <TextBlock x:Name="IntoLabel"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="8,0,0,3"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <TextBox x:Name="UrlBox"
                         Grid.Row="2"
                         VerticalAlignment="Center"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         TextChanged="OnUrlChanged" />

                <!-- Derived from the URL until the user types here, at which point it is theirs —
                     the same rule the clone dialog's target box follows. -->
                <TextBox x:Name="IntoBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         TextChanged="OnIntoChanged" />

                <Button x:Name="AddButton"
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        MinWidth="90"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnAdd" />

                <TextBlock x:Name="AddHint"
                           Grid.Row="3"
                           Grid.ColumnSpan="3"
                           Margin="0,7,0,0"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Style="{StaticResource Muted}" />
            </Grid>
        </Border>

        <!-- Commit… appears only once this window has staged something. It opens the commit window
             and does not commit: that window is the product's only commit surface, and a second one
             here would be a second place for every commit rule to live. -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Muted}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CommitButton"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnCommit" />

                    <Button x:Name="CloseButton"
                            MinWidth="80"
                            IsCancel="True"
                            Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
