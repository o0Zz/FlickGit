<Window x:Class="FlickGit.App.Views.QuickCommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding RepositoryName}"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Surface}">

    <!-- The fast path. Deliberately smaller than the commit window, which is the escape hatch:
         a summary line instead of a file list, no diff, and three buttons.

         WindowStyle="None" because a title bar on a popup anchored at the cursor is 30 px of
         chrome the user never clicks, and because the repository name is already the first thing
         inside. Topmost and ShowInTaskbar="False" for the same reason: this is a transient
         surface over whatever the user was looking at, not a window they manage.

         WindowStartupLocation="Manual" is load-bearing. CenterScreen would override the cursor
         anchoring the host computes, and the whole point is that the popup appears where the
         user's attention already is. -->

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header. The repository is shown permanently because the user did not choose it:
                 the trigger resolved it from whatever Explorer had in front. -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding RepositoryName}" Style="{StaticResource HeaderTitle}" />
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>

                    <!-- "using the most recent repository". Only visible when the folder could not
                         be resolved, and then it has to be impossible to miss. -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding HeaderHint}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MaxWidth="150"
                               Foreground="{StaticResource DangerText}" />
                </Grid>
            </Border>

            <!-- Warning strip: committing to the primary branch, or an unresolved conflict. -->
            <Border Grid.Row="1"
                    Background="{StaticResource WarnBackground}"
                    BorderBrush="{StaticResource WarnBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="14,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNotice}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="11.5" />
            </Border>

            <!-- Branch. The same editable ComboBox as the commit window, with the same inline
                 hint: the consequence of Enter is visible before Enter. -->
            <Border Grid.Row="2" Padding="14,10,14,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BranchLabel"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Style="{StaticResource SectionLabel}" />

                    <ComboBox x:Name="BranchBox"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              Width="230"
                              ItemsSource="{Binding Branches}"
                              Text="{Binding BranchInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontFamily="Cascadia Mono, Consolas, Courier New"
                              VerticalContentAlignment="Center" />

                    <TextBlock Text="{Binding BranchHint}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BranchResolution.Intent}" Value="Invalid">
                                        <Setter Property="Foreground" Value="{StaticResource DangerText}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BranchResolution.Intent}" Value="NewBranch">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- The message. Focused on open, because it is the only thing the user has to supply. -->
            <Border Grid.Row="3" Padding="14,8,14,10">
                <TextBox x:Name="MessageBox"
                         Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="54"
                         MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas, Courier New" />
            </Border>

            <Border Grid.Row="4"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,0"
                    Padding="14,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- The label is bound, not set: it is how a queued Enter reports
                             itself while the message is still arriving. -->
                        <Button Content="{Binding CommitAndPushText}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="130"
                                Padding="10,5"
                                Command="{Binding CommitAndPushCommand}" />
                        <Button x:Name="CommitButton"
                                MinWidth="76"
                                Padding="10,5"
                                Margin="6,0,0,0"
                                Command="{Binding CommitCommand}" />
                        <Button x:Name="DetailsButton"
                                MinWidth="76"
                                Padding="10,5"
                                Margin="6,0,0,0"
                                Click="OnDetails" />
                    </StackPanel>

                    <!-- The keyboard map, and the outcome line in its place once there is one.
                         The hints are what teach the one-key path; showing them until they are
                         no longer the most useful thing in that space is the point. -->
                    <TextBlock x:Name="HintText" Margin="0,7,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="FontSize" Value="11" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatusText}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,7,0,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatusText}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
