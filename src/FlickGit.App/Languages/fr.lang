# FlickGit — Français. Traduction de en.lang, qui reste le fichier maître : toute ligne
# absente ici s'affiche en anglais plutôt que d'afficher sa clé.
#
# Format : une paire "clé = valeur" par ligne, # pour un commentaire, \n pour un saut de
# ligne. Tout ce qui suit le premier = est le texte, donc = n'a pas à être échappé.
# @name est le nom de la langue dans cette langue, jamais traduit.

@name = Français

app.name = FlickGit

# ---- communs ----
# Un mot par sens. Un bouton qui ne fait que fermer une fenêtre dit Fermer ; seul
# celui qui interrompt vraiment une opération dit Annuler.
