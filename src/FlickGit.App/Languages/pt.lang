stash.push = Guardar
stash.pop = Aplicar o stash
stash.drop = Descartar o stash
stash.none = Não há nada guardado no stash deste repositório.
# {0} número de stashes
stash.count = {0} stash(es)
stash.pushed = Guardado. As suas alterações estão no stash.
stash.nothing = Nada para guardar. Não há alterações a pôr de lado, e os ficheiros não controlados só contam quando são incluídos.
# {0} referência do stash
stash.popped = {0} aplicado e removido.
stash.dropped = {0} descartado.
stash.pop.kept = {0} continua na lista, portanto nada se perdeu. A mensagem do Git está abaixo: ou não alterou nada, ou aplicou o que podia e deixou conflitos para resolver.
stash.menu.pop = Aplicar {0}
