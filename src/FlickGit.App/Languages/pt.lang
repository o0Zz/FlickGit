# ---- janela de stashes ----
# Um stash é trabalho posto de lado. Uma linha é indicada pela sua *posição* — stash@{1} é o que
# está em segundo lugar neste momento. O FlickGit confirma que continua a ser o mesmo stash antes de
# o aplicar ou descartar; stash.moved comunica o outro caso.

# {0} nome do repositório
stash.title = Stashes — {0}
stash.new = Guardar as suas alterações
stash.message.label = Mensagem — opcional; sem ela, o Git nomeia o commit em que estava
stash.untracked = Incluir os não controlados
