# FlickGit — Português. Tradução de en.lang, que continua a ser o ficheiro mestre: uma
# linha em falta aqui aparece em inglês em vez de mostrar a sua chave.
#
# Formato: um par "chave = valor" por linha, # para um comentário, \n para uma quebra de
# linha. Tudo o que vem depois do primeiro = é o texto, por isso = não precisa de escape.
# @name é o nome do idioma no próprio idioma, nunca traduzido.

@name = Português

app.name = FlickGit

# ---- comuns ----
# Uma palavra por significado. Um botão que apenas fecha uma janela diz Fechar; só
# aquele que realmente interrompe uma operação diz Cancelar.
