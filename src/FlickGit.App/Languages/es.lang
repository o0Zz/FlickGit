# pregunta.
# {0} ruta relativa al repositorio
file.added = {0} preparado
file.removed = {0} eliminado — la eliminación está preparada, no confirmada.
file.untracked = Git no sigue {0}, así que no hay nada que quitar. La eliminación del Explorador borra el archivo en sí.
# {0} la ruta tal como se dio, {1} raíz del repositorio
file.outside = {0} está fuera de {1} y no se tocará.
file.remove.title = Eliminar archivo
# {0} ruta relativa al repositorio
file.remove.ask = ¿Eliminar {0}?\n\nSe borra del disco y la eliminación queda preparada, no confirmada. HEAD sigue teniendo el archivo, así que «Revertir archivo…» lo devuelve.\n\nGit se niega si el archivo tiene cambios que nunca se confirmaron.
file.remove.yes = Eliminar

