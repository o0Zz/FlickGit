# FlickGit — Español. Traducción de en.lang, que sigue siendo el archivo maestro: cualquier
# línea que falte aquí se muestra en inglés en lugar de mostrar su clave.
#
# Formato: un par "clave = valor" por línea, # para un comentario, \n para un salto de
# línea. Todo lo que sigue al primer = es el texto, así que = no necesita escaparse.
# @name es el nombre del idioma en ese idioma, nunca se traduce.

@name = Español

app.name = FlickGit

