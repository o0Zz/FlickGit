# ---- revertir un archivo ----
revert.menu = Revertir archivo…
revert.title = Revertir archivo
revert.question = ¿Revertir {0}?
revert.body = La versión del disco va a la Papelera de reciclaje y la de HEAD la sustituye — en el árbol de trabajo y en el índice. No se confirma ni se envía nada.
revert.body.unstage = HEAD no tiene ninguna copia de este archivo, así que revertirlo significa quitarlo del área de preparación. El archivo se queda exactamente donde está, como archivo sin rastrear: no se borra nada y nada va a la Papelera de reciclaje.
