# FlickGit — Italiano. Traduzione di en.lang, che resta il file principale: una riga
# mancante qui viene mostrata in inglese anziché mostrare la sua chiave.
#
# Formato: una coppia "chiave = valore" per riga, # per un commento, \n per un a capo.
# Tutto ciò che segue il primo = è il testo, quindi = non va protetto.
# @name è il nome della lingua in quella lingua, mai tradotto.

@name = Italiano

app.name = FlickGit

