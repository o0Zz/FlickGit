# ---- deleting a file ----
# The commit window's file list, right-click. Removes the file from the working tree and sends
# it to the Recycle Bin, which is what makes one question enough for a destructive action.
delete.menu = Delete file…
delete.title = Delete file
# {0} repository-relative path
delete.question = Delete {0}?
delete.tracked = It goes to the Recycle Bin. Git still has it, so the deletion becomes a change you can commit — or undo with git restore.
delete.untracked = It goes to the Recycle Bin. Git has never seen this file, so that is the only way back.
delete.yes = Delete
delete.no = Keep
# {0} repository-relative path
delete.done = Deleted {0}
delete.missing = {0} is no longer on disk.
# {0} repository-relative path, {1} repository root
delete.outside = {0} is outside {1} and will not be deleted.
delete.reparsepoint = {0} is a symlink or junction. FlickGit will not delete through one.
# {0} repository-relative path, {1} the reason Windows gave
delete.failed = {0} could not be deleted:\n\n{1}

# ---- reverting a file ----
# The commit window's file list, right-click. Puts the file back the way HEAD has it, sending
# the copy on disk to the Recycle Bin first -- the same trade delete.* makes, and the reason
# one question is enough for a destructive action.
revert.menu = Revert file…
revert.title = Revert file
# {0} repository-relative path
revert.question = Revert {0}?
revert.body = The version on disk goes to the Recycle Bin, and HEAD's version replaces it — in the working tree and in the index. Nothing is committed and nothing is pushed.
revert.dirty = Your unsaved edits in the diff pane were never written to disk, so the Recycle Bin will not have them.
revert.yes = Revert
revert.no = Keep
revert.done = Reverted {0}
revert.failed = {0} could not be reverted:
revert.binned = The version that was on disk is in the Recycle Bin.

