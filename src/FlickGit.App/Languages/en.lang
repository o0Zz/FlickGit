# FlickGit — English. The master file: every other language falls back to this one key
# by key, so a line missing elsewhere shows in English rather than showing its key.
#
# Format: one "key = value" per line, # for a comment, \n for a line break.
# Everything after the first = is the text, so = needs no escaping.
# @name is the language's name for itself, shown in the Settings picker.

@name = English

app.name = FlickGit

